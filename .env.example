# Vocalis AI - Environment Configuration Example

# ==========================================================
# VARIÁVEIS PÚBLICAS DE CLIENTE (expostas no bundle Vite)
# Nunca coloque chaves privadas, tokens secretos ou senhas em VITE_*
# ==========================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ==========================================================
# VARIÁVEIS ESTRITAMENTE DE SERVIDOR (Vercel / Node backend)
# ==========================================================
GEMINI_API_KEY=your-server-only-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
MCP_API_KEY=your-mcp-bearer-secret
OPENBOT_WEBHOOK_SECRET=your-openbot-webhook-secret
ALLOWED_ORIGINS=https://vocalisai-phi.vercel.app

# Protótipo local de desenvolvimento WhatsApp (whatsapp-server/)
WHATSAPP_LOCAL_API_KEY=your-local-dev-secret
